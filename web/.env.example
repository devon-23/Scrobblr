# Copy this file to `.env.local` (gitignored) and fill in real values.
# Set the same variables in Cloudflare → your Worker → Settings → Build → Variables and secrets.
#
# Everything prefixed VITE_ is compiled into the public JavaScript bundle.
# Only put values here that are SAFE TO BE PUBLIC.

# Supabase dashboard → Project Settings → Data API (or API Keys) → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase dashboard → Project Settings → API Keys → "Publishable key" (sb_publishable_...)
# The legacy "anon" key also works. NEVER put the secret / service_role key here —
# the app refuses to start if it detects one.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
