# Secrets for the lastfm Edge Function. NEVER commit real values.
# Set them on your Supabase project with:
#   supabase secrets set --env-file supabase/functions/.env
# (after copying this file to supabase/functions/.env, which is gitignored)

# From https://www.last.fm/api/accounts (after creating an API account)
LASTFM_API_KEY=your-32-character-api-key
LASTFM_SHARED_SECRET=your-32-character-shared-secret

# Where the app runs, comma-separated, no trailing slash. Used for CORS and to
# validate the Last.fm callback URL.
ALLOWED_ORIGINS=http://localhost:5173,https://analogscrobbler.pages.dev
